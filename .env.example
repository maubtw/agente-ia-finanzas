# Copia este archivo a .env y ajusta valores. NUNCA subas .env al repositorio.

# Backend
BACKEND_API_KEY=cambia-esta-clave-larga-y-aleatoria
CORS_ORIGINS=http://localhost:5173
HTTP_TIMEOUT_S=10

# Fuentes de datos públicas (solo lectura; no se requiere clave de trading)
MEXC_BASE_URL=https://api.mexc.com
MEXC_SIMBOLOS_PERMITIDOS=BTCUSDT,ETHUSDT
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# Frontend (solo la URL del backend para el proxy de Vite; nunca secretos en VITE_*)
VITE_BACKEND_URL=http://localhost:8000
